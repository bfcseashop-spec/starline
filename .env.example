# Browser → Nest API (PostgreSQL via Node backend). Must match the Nest listen port (API_PORT below).
VITE_API_URL=http://localhost:4042

# Optional: folder of <table>.json files for `npm run import:data` (default: backend/data-export).
# DATA_EXPORT_DIR=./backend/data-export

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=starline_user
PGPASSWORD=starlinepass123
PGDATABASE=starline

API_PORT=4042
JWT_SECRET=replace-me

DEFAULT_ADMIN_EMAIL=admin@starlineb.com
DEFAULT_ADMIN_PASSWORD=Admin@2814
DEFAULT_ADMIN_NAME=Starline Admin

# Social broadcasting
# 32-byte key for AES-256-GCM encryption of stored social tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_ENCRYPTION_KEY=

# Public origin used in OAuth callback URLs (no trailing slash)
PUBLIC_API_URL=http://localhost:4042
PUBLIC_APP_URL=http://localhost:8080

# Optional defaults — admin can also enter these per-connection in the UI
# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Meta (Facebook + Instagram) — Graph API
META_APP_ID=
META_APP_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google (YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter / X — paid Basic tier required for posting
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ENABLED=false

# TikTok — Content Posting API (invite-only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Playwright (WhatsApp Status)
PLAYWRIGHT_PROFILES_DIR=./playwright-profiles
